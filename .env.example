# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# The Java services read this file from their own folder or the repo root;
# real environment variables take precedence.

# MySQL (placement-service, attendance-service, timetable-service, checkin-service)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me

# import-service uses DB_USER instead of DB_USERNAME
DB_USER=root

# Kafka
KAFKA_BOOTSTRAP=localhost:9092
